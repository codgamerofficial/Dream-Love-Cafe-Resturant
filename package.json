{
  "name": "dream-love-restaurant",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node \"./node_modules/expo/bin/cli\" start",
    "dev": "node \"./node_modules/expo/bin/cli\" start --web",
    "android": "node \"./node_modules/expo/bin/cli\" start --android",
    "ios": "node \"./node_modules/expo/bin/cli\" start --ios",
    "web": "node \"./node_modules/expo/bin/cli\" start --web",
    "build:web": "node \"./node_modules/expo/bin/cli\" export -p web",
    "seed:db": "node scripts/seed-supabase.js",
    "preview": "node scripts/serve-dist.js",
    "lint": "node \"./node_modules/typescript/bin/tsc\" --noEmit",
    "test": "node \"./node_modules/jest/bin/jest.js\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
